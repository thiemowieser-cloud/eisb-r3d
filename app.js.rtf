\f0\fs24 \cf0 let scene, camera, renderer, objects = [];\
\
init();\
animate();\
\
function init() \{\
    scene = new THREE.Scene();\
    scene.background = new THREE.Color(0x111122);\
\
    camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);\
    camera.position.set(0, 2, 5);\
\
    renderer = new THREE.WebGLRenderer(\{ antialias: true \});\
    renderer.setSize(window.innerWidth, window.innerHeight * 0.8);\
    document.getElementById('viewer').appendChild(renderer.domElement);\
\
    const light = new THREE.DirectionalLight(0xffffff, 1);\
    light.position.set(5,10,7);\
    scene.add(light);\
\
    // Event: OBJ-Upload\
    document.getElementById('obj-upload').addEventListener('change', handleOBJUpload);\
    document.getElementById('start-animation').addEventListener('click', startAnimation);\
\
    window.addEventListener('resize', onWindowResize);\
\}\
\
function handleOBJUpload(event) \{\
    const files = event.target.files;\
    for(let file of files) \{\
        const reader = new FileReader();\
        reader.onload = function(e) \{\
            const contents = e.target.result;\
            const loader = new THREE.OBJLoader();\
            const obj = loader.parse(contents);\
            obj.position.x = objects.length * 2;\
            scene.add(obj);\
            objects.push(obj);\
        \};\
        reader.readAsText(file);\
    \}\
\}\
\
function startAnimation() \{\
    const desc = document.getElementById('animation-description').value;\
    // Hier k\'f6nnen Bewegungen basierend auf Textbeschreibung implementiert werden\
    // Beispiel: Objekte rotieren\
    objects.forEach(obj => obj.userData.rotationSpeed = 0.01);\
\}\
\
function animate() \{\
    requestAnimationFrame(animate);\
    objects.forEach(obj => \{\
        if(obj.userData.rotationSpeed) obj.rotation.y += obj.userData.rotationSpeed;\
    \});\
    renderer.render(scene, camera);\
\}\
\
function onWindowResize() \{\
    camera.aspect = window.innerWidth / (window.innerHeight * 0.8);\
    camera.updateProjectionMatrix();\
    renderer.setSize(window.innerWidth, window.innerHeight * 0.8);\
\}\
}